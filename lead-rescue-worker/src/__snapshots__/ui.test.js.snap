      <script id="viajes-json" type="application/json">[{"trip_id":"VIAJE-002","chofer":"María González","chofer_id":"CHF-02","detalle_paradas":[{"ot_id":"OT-2001","cliente":"Empresa Gamma","monto_total":200000,"estado_operacional":"EN_RUTA","eta":"2025-07-01T14:00:00.000Z","fecha_hora_sla":"2025-07-01T18:00:00.000Z","hora_real":null,"metadata":null,"_fecha_sla_str":"14:00","_hora_real_str":"--:--","_eta_str":"10:00","_search_str":"ot-2001 empresa gamma"},{"ot_id":"OT-2002","cliente":"Empresa Delta","monto_total":150000,"estado_operacional":"ENTREGADO","eta":"2025-07-01T16:00:00.000Z","fecha_hora_sla":"2025-07-01T13:00:00.000Z","hora_real":"2025-07-01T12:30:00.000Z","metadata":null,"_fecha_sla_str":"09:00","_hora_real_str":"08:30","_eta_str":"12:00","_search_str":"ot-2002 empresa delta"}],"_multa_calculada":0,"_riesgo_dinamico":0,"_search_str":"viaje-002 maría gonzález ot-2001 empresa gamma ot-2002 empresa delta","km_recorridos":0,"valor_total_viaje":350000,"total_paradas":2,"entregas_completadas":1,"entregas_rechazadas":0,"paradas_atrasadas":0},{"trip_id":"VIAJE-003","chofer":"Pedro Soto","chofer_id":"CHF-03","detalle_paradas":[{"ot_id":"OT-3001","cliente":"Empresa Epsilon","monto_total":100000,"estado_operacional":"ENTREGADO","eta":"2025-07-01T14:00:00.000Z","fecha_hora_sla":"2025-07-01T18:00:00.000Z","hora_real":"2025-07-01T10:00:00.000Z","metadata":null,"_fecha_sla_str":"14:00","_hora_real_str":"06:00","_eta_str":"10:00","_search_str":"ot-3001 empresa epsilon"},{"ot_id":"OT-3002","cliente":"Empresa Zeta","monto_total":75000,"estado_operacional":"RECHAZADO","eta":"2025-07-01T14:00:00.000Z","fecha_hora_sla":"2025-07-01T18:00:00.000Z","hora_real":"2025-07-01T11:00:00.000Z","metadata":null,"_fecha_sla_str":"14:00","_hora_real_str":"07:00","_eta_str":"10:00","_search_str":"ot-3002 empresa zeta"}],"_multa_calculada":0,"_riesgo_dinamico":0,"_search_str":"viaje-003 pedro soto ot-3001 empresa epsilon ot-3002 empresa zeta"}]</script>
      <script id="config-json" type="application/json">{"BODEGA":{"LAT":-33.5132,"LNG":-70.7672,"NOMBRE":"Bodega Central"},"ESTADOS":{"PENDIENTE":"PENDIENTE_RUTEO","ASIGNADO":"CAMION_ASIGNADO","EN_RUTA":"EN_RUTA","ENTREGADO":"ENTREGADO","RECHAZADO":"RECHAZADO","CANCELADO":"CANCELADO_PLANILLA","RETORNO":"RETORNO_BODEGA"},"UI":{"COLORS":{"EXITO":"#10b981","ALERTA":"#ef4444","NEUTRAL":"#2563eb","WARNING":"#f59e0b"}},"tenant_id":"empresa_demo","operator":null,"depots":[],"last_sync_date":null}</script>
